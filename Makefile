# Bulmo Multisend: common tasks
.PHONY: build test test-deep coverage snapshot abi fmt deploy-dry deploy deploy-factory-dry deploy-factory pricing-dry pricing pricing-safe ledger-list

build:      ; forge build --sizes
test:       ; forge test
test-deep:  ; FOUNDRY_PROFILE=deep forge test        # 100k fuzz runs, 2k invariant runs: run before every deploy
coverage:   ; forge coverage --report summary
snapshot:   ; forge snapshot --match-test test_gas
fmt:        ; forge fmt

# Export the ABIs as one TypeScript module: abi/bulmo-multisend.ts (or ABI_OUT=<dir>)
ABI_OUT ?= abi
abi:
	@mkdir -p $(ABI_OUT) && m="$$(forge inspect BulmoMultisend abi --json)" && f="$$(forge inspect BulmoMultisendFactory abi --json)" && p="$$(forge inspect BulmoPersonalMultisend abi --json)" && \
	 printf '// Generated by bulmo-multisend-contracts (make abi). Do not edit.\nexport const bulmoMultisendAbi = %s as const;\n\nexport const bulmoMultisendFactoryAbi = %s as const;\n\nexport const bulmoPersonalMultisendAbi = %s as const;\n' "$$m" "$$f" "$$p" \
	   > $(ABI_OUT)/bulmo-multisend.ts && echo "ABIs written to $(ABI_OUT)/bulmo-multisend.ts"

# Who signs. Default: Foundry keystore accounts "deployer" (deploys) and "owner" (pricing).
# HW=ledger signs on the device instead:  make pricing CHAIN=base HW=ledger FROM=0x<ledger address> ...
# Other Ledger accounts: add HDPATH="m/44'/60'/1'/0/0"
ifeq ($(HW),ledger)
DEPLOY_SIGNER = --ledger --sender $(FROM) $(if $(HDPATH),--hd-paths "$(HDPATH)")
OWNER_SIGNER  = $(DEPLOY_SIGNER)
else
DEPLOY_SIGNER = --account deployer
OWNER_SIGNER  = --account owner
endif

# Lists the addresses on a connected, unlocked Ledger (Ethereum app open). Signs nothing.
ledger-list: ; cast wallet list --ledger --max-senders 3

# Usage: make deploy-dry CHAIN=base   then   make deploy CHAIN=base
deploy-dry: ; forge script script/Deploy.s.sol --rpc-url $(CHAIN) $(DEPLOY_SIGNER)
deploy:     ; forge script script/Deploy.s.sol --rpc-url $(CHAIN) $(DEPLOY_SIGNER) --slow --broadcast --verify
deploy-factory-dry: ; forge script script/DeployFactory.s.sol --rpc-url $(CHAIN) $(DEPLOY_SIGNER)
deploy-factory:     ; forge script script/DeployFactory.s.sol --rpc-url $(CHAIN) $(DEPLOY_SIGNER) --slow --broadcast --verify

# Per-chain price source, after both deploys. Usage: make pricing-dry CHAIN=base MULTISEND=0x.. FACTORY=0x..
pricing-dry:  ; FOUNDRY_PROFILE=pricing forge script script/SetPricing.s.sol --rpc-url $(CHAIN)
pricing:      ; FOUNDRY_PROFILE=pricing forge script script/SetPricing.s.sol --rpc-url $(CHAIN) $(OWNER_SIGNER) --broadcast --slow
pricing-safe: ; FOUNDRY_PROFILE=pricing forge script script/SetPricing.s.sol --rpc-url $(CHAIN) --sig "printCalldata()"
