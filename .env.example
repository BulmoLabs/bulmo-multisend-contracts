# Deploy settings: keep these identical on every chain to get the same contract addresses.
OWNER=0x0000000000000000000000000000000000000000
# Prices are USD with 8 decimals ($1 = 100000000). Defaults shown; real pricing ships at deploy.
# MAX_FEE_USD=10000000000                              # $100 cap per send (can only be lowered)
# TIER_MAX_RECIPIENTS=5,20,50,500
# TIER_FEES_USD=0,1000000000,1900000000,4900000000      # $0 / $10 / $19 / $49
# MAX_NATIVE_CHARGE=10000000000000000000                # 10 coins: shared hard cap on any single charge; lower per chain after deploy
# SALT=0x...                                            # optional

# Personal Multisend factory (identical on every chain)
# FACTORY_MAX_PRICE_USD=10000000000                     # $100 cap
# FACTORY_PRICE_USD=4900000000                          # $49
# FACTORY_SALT=0x...

# Per-chain price source (SetPricing.s.sol). Ethereum, BNB Chain, Base and Arbitrum are built in.
# PRICE_FEED=0x...            # HyperEVM HYPE / USD, Robinhood Chain ETH / USD: from docs.chain.link
# SEQUENCER_FEED=0x...        # Robinhood Chain L2 sequencer uptime feed, if listed
# MAX_PRICE_AGE=3600          # seconds: the feed's heartbeat plus a margin
# FEED_DESCRIPTION="HYPE / USD"
# MANUAL_PRICE=4000000000     # Elysium (no Chainlink): HYPE price, 8 decimals
# NEW_MAX_NATIVE_CHARGE=...   # wei; the script prints a ~$300 suggestion

# One free key from etherscan.io, for script/verify-etherscan.sh
# ETHERSCAN_API_KEY=

# RPC endpoints
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz

# Never put a private key here. Import it once into Foundry's encrypted keystore:
#   cast wallet import deployer --interactive
